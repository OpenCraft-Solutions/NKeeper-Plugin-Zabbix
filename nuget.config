<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NKeeper's SDK, plugin build and test packages come from GitHub Packages, which needs a token even for public
    packages: set NUGET_AUTH_TOKEN (a GitHub token that can read packages) and GITHUB_ACTOR, or NUGET_USERNAME.
    The token is read from the environment, never from this file.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-opencraft" value="https://nuget.pkg.github.com/OpenCraft-Solutions/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-opencraft>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github-opencraft>
  </packageSourceCredentials>
  <!-- NKeeper's own packages come only from GitHub Packages, so another feed can't substitute one. -->
  <packageSourceMapping>
    <packageSource key="github-opencraft">
      <package pattern="NKeeper.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
